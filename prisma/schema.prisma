generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  galleries Gallery[]
}

model Gallery {
  id         Int      @id @default(autoincrement())
  imageUrl   String    @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}